# AI Game Studio — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── Required ────────────────────────────────────────────────
# Claude API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram Bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABC...

# OpenAI API key for DALL-E 3 image generation
# (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# ─── Security ────────────────────────────────────────────────
# Your Telegram chat ID — only this user can control the bot
# To find your chat ID: message @userinfobot on Telegram
# Leave empty to allow any user (not recommended for production)
ALLOWED_CHAT_ID=

# ─── Optional (for production webhook mode) ──────────────────
# Public HTTPS URL where the bot is hosted
# If empty, the bot will use polling mode (fine for local dev)
WEBHOOK_URL=

# Port for the Express webhook server (default: 3000)
PORT=3000

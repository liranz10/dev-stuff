# Environment variables — NEVER commit
.env
.env.local
.env.*.local

# Node dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
*/dist/
*.local

# iOS build artifacts (generated by Capacitor)
games/*/ios/
!games/_template/ios/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Generated assets (large files)
games/*/src/assets/*.png
games/*/src/assets/*.jpg
games/*/src/assets/*.mp3
games/*/src/assets/*.wav
# Keep manifest
!games/*/src/assets/manifest.json
# Keep template assets
!games/_template/src/assets/

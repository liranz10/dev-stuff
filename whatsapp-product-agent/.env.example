# Anthropic API Key - get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional: limit which phone numbers the bot responds to (comma-separated, with country code)
# Leave empty to respond to all messages
# Example: ALLOWED_NUMBERS=972501234567,972521234567
ALLOWED_NUMBERS=

# Optional: keyword to trigger the bot in group chats (default: disabled in groups)
# Example: GROUP_TRIGGER=!מצא
GROUP_TRIGGER=
